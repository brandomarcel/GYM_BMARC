{
  "doctype": "DocType",
  "name": "GYM Promotion",
  "module": "Gym BMARC",
  "engine": "InnoDB",
  "autoname": "hash",
  "allow_rename": 0,
  "track_changes": 1,
  "make_attachments_public": 0,
  "fields": [
    {
      "fieldname": "business",
      "label": "Negocio",
      "fieldtype": "Link",
      "options": "FacturADA Business",
      "reqd": 1,
      "search_index": 1
    },
    {
      "fieldname": "promotion_name",
      "label": "Promoción",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "plan",
      "label": "Plan elegible",
      "fieldtype": "Link",
      "options": "GYM Membership Plan",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "label": "Estado",
      "fieldtype": "Select",
      "options": "Activo\nInactivo",
      "default": "Activo",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "valid_from",
      "label": "Disponible desde",
      "fieldtype": "Date",
      "reqd": 1
    },
    {
      "fieldname": "valid_until",
      "label": "Disponible hasta",
      "fieldtype": "Date",
      "reqd": 1
    },
    {
      "fieldname": "benefit_type",
      "label": "Tipo de descuento",
      "fieldtype": "Select",
      "options": "Porcentaje\nImporte fijo",
      "reqd": 1,
      "default": "Porcentaje"
    },
    {
      "fieldname": "benefit_value",
      "label": "Valor del descuento",
      "fieldtype": "Float",
      "precision": "2",
      "reqd": 1,
      "description": "Porcentaje entre 0 y 100 o importe en USD, según el tipo."
    },
    {
      "fieldname": "description",
      "label": "Descripción",
      "fieldtype": "Small Text",
      "description": "Descuento individual al contratar una membresía. Las promociones grupales 2×1 todavía no están disponibles."
    },
    {
      "fieldname": "desk_section_0",
      "fieldtype": "Section Break",
      "label": "Promoción y plan"
    },
    {
      "fieldname": "desk_section_1",
      "fieldtype": "Section Break",
      "label": "Vigencia y descuento"
    }
  ],
  "field_order": [
    "desk_section_0",
    "business",
    "promotion_name",
    "plan",
    "status",
    "desk_section_1",
    "valid_from",
    "valid_until",
    "benefit_type",
    "benefit_value",
    "description"
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "create": 1,
      "write": 1,
      "delete": 1,
      "print": 1
    },
    {
      "role": "GYM User",
      "read": 1,
      "create": 1,
      "write": 1,
      "delete": 1,
      "print": 1
    }
  ],
  "title_field": "promotion_name",
  "sort_field": "modified",
  "sort_order": "DESC",
  "actions": [],
  "links": [],
  "states": []
}
